{
  "version": 1,
  "author": "Sentinela de Cadeia Fria",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },

    { "type": "wokwi-dht22", "id": "dht", "top": -120, "left": -230,
      "attrs": { "temperature": "24", "humidity": "55" } },

    { "type": "wokwi-slide-switch", "id": "tampa", "top": 70, "left": -240,
      "attrs": { "value": "1", "bounce": "1" } },

    { "type": "wokwi-pushbutton", "id": "reset", "top": 220, "left": -230,
      "attrs": { "color": "blue", "label": "RESET" } },

    { "type": "wokwi-rgb-led", "id": "semaforo", "top": -130, "left": 290,
      "attrs": { "common": "cathode" } },
    { "type": "wokwi-resistor", "id": "r_vermelho", "top": -40, "left": 220, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r_verde",    "top": -10, "left": 220, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r_azul",     "top":  20, "left": 220, "attrs": { "value": "220" } },

    { "type": "wokwi-buzzer", "id": "buzzer", "top": 130, "left": 250,
      "attrs": { "volume": "0.4", "mode": "smooth" } },

    { "type": "wokwi-relay-module", "id": "rele", "top": -150, "left": 470,
      "attrs": { "transistor": "pnp" } },

    { "type": "wokwi-led", "id": "farol", "top": 60, "left": 660,
      "attrs": { "color": "red", "label": "RETENCAO" } },
    { "type": "wokwi-resistor", "id": "r_farol", "top": 130, "left": 590, "attrs": { "value": "330" } },

    { "type": "wokwi-text", "id": "t1", "top": -180, "left": -240,
