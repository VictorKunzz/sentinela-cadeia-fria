# Copie para ".env" e preencha. O .env e ignorado pelo git.
# Valores abaixo sao exemplos de desenvolvimento: troque antes de qualquer demonstracao.

# --- Banco ---
POSTGRES_DB=sentinela
POSTGRES_USER=sentinela
POSTGRES_PASSWORD=troque-esta-senha

# --- Mosquitto: um usuario por cliente (o usuario dos dispositivos e o deviceId) ---
MQTT_PASS_BACKEND=troque-esta-senha
MQTT_PASS_CF01=troque-esta-senha
MQTT_PASS_VENT01=troque-esta-senha

# --- Backend -> broker ---
# Padrao: o container do Mosquitto. Para testar com o Wokwi, aponte para o
# broker publico e use um prefixo exclusivo (ver MQTT_TOPIC_PREFIX).
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=backend
# Prefixo da arvore de topicos. Em producao: sentinela/cadeia-fria.
# No modo Wokwi: algo unico, ex. sentinela-teste-a1b2c3/cadeia-fria.
MQTT_TOPIC_PREFIX=sentinela/cadeia-fria

# --- Autenticacao da interface (usuarios-semente) ---
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria
JWT_EXPIRA_MIN=480
SEED_COORDENACAO_USER=coordenacao
SEED_COORDENACAO_PASSWORD=troque-esta-senha
SEED_TECNICO_USER=tecnico
SEED_TECNICO_PASSWORD=troque-esta-senha

# --- Ciclo de comando (segundos) ---
COMANDO_PRAZO_RECEBIDO_S=5
COMANDO_PRAZO_TOTAL_S=15

# --- Regra R8 (valores iniciais; editaveis pela API /regras) ---
REGRA_TEMP_LIGAR=30
REGRA_TEMP_DESLIGAR=26
REGRA_JANELA_S=120

# --- Telegram (opcional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
